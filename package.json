    "format:check": "prettier --check ."
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.33.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
