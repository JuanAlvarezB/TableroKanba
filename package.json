{
  "name": "lucas",
  "private": true,
  "version": "1.0.0",
  "description": "LUCAS organiza tu día a día: tablero de tareas con Firebase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
