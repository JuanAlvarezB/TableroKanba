# Configuración de Firebase de cada ambiente (ver src/shared/config/firebase.config.js).
# Copia este archivo como .env.local y rellena los valores de la consola de Firebase:
# Configuración del proyecto → Tus apps → Configuración del SDK.
# Son valores públicos por diseño (los datos los protegen las reglas de Firestore), pero
# .env.local no se commitea. En GitHub Actions se leen de las variables del repositorio:
#   gh variable set -f .env.local
#
# Desarrollo: proyecto tablero-kanban-dev
VITE_FIREBASE_DEV_API_KEY=
VITE_FIREBASE_DEV_AUTH_DOMAIN=
VITE_FIREBASE_DEV_PROJECT_ID=
VITE_FIREBASE_DEV_STORAGE_BUCKET=
VITE_FIREBASE_DEV_MESSAGING_SENDER_ID=
VITE_FIREBASE_DEV_APP_ID=

# PDN: proyecto tablero-kanban-76c61
VITE_FIREBASE_PDN_API_KEY=
VITE_FIREBASE_PDN_AUTH_DOMAIN=
VITE_FIREBASE_PDN_PROJECT_ID=
VITE_FIREBASE_PDN_STORAGE_BUCKET=
VITE_FIREBASE_PDN_MESSAGING_SENDER_ID=
VITE_FIREBASE_PDN_APP_ID=
